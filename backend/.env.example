# ══════════════════════════════════════════════════════════════════════════
# CHM Finance — backend environment
# Copy to `.env` and fill in for your environment.
# In production, all "CRITICAL" vars MUST be set or the server refuses to start.
# ══════════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production
PORT=3000
LOG_LEVEL=debug                # error | warn | info | debug

# ── CRITICAL: Authentication secrets ──────────────────────────────────────
# Generate each with: openssl rand -hex 32
# Must be at least 32 chars. In prod they MUST differ from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# ── CRITICAL: Encryption key for API keys at rest ─────────────────────────
# AES-256-GCM requires 32 bytes = exactly 64 hex chars.
# Generate with: openssl rand -hex 32
# NEVER change this in production without re-encrypting all exchange_keys rows.
WALLET_ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_PATH=./data/chmup.db

# ── CORS ──────────────────────────────────────────────────────────────────
# Dev: use "*". Prod: lock to your domain (e.g. https://chmup.top)
CORS_ORIGIN=*

# ── Payments: Stripe (required in prod for fiat) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ── Payments: Crypto (optional but recommended) ───────────────────────────
PAYMENT_BEP20_ADDRESS=
PAYMENT_TRC20_ADDRESS=
BSCSCAN_API_KEY=
TRONSCAN_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Signal engine (workers/engineWorker.js) ───────────────────────────────
# 1 = scanners / WS feeds / tracker in a worker thread (default 1 in production, 0 elsewhere)
ENGINE_WORKER=
# Auto-trade (services/autotrade, real orders with the users' keys). 1 = the engine worker places
# trades; anything else = signals only (no order is ever sent). Default off.
AUTOTRADE_ENABLED=
# Exchanges auto-trade AND the trade-ops loops may touch (D5): default "bybit,bingx"; Binance / OKX only
# after a sandbox run. A user / trade on another exchange reads as "no keys" in every loop.
AUTOTRADE_EXCHANGES=
# The M15 trade-ops loops in the engine worker (BE monitor, state reconcile, stuck-PLACING cleanup, SL
# verifier, anomaly detector, orphan sweeper — services/autotrade/tradeLoops.js, PLAN_M15 D22):
# 1 = on, 0 = off, unset / anything else = follow AUTOTRADE_ENABLED. AUTOTRADE_ENABLED=1 with 0 here
# refuses to start auto-trade (positions would have no BE monitor / reconcile); 1 with auto-trade off =
# "protect only" (existing positions are managed, nothing new is placed). The killswitch (HALTED_NEW)
# stops entries only — the loops keep protecting positions.
# Run ONE application process (PassengerMaxInstances 1 / PassengerMinInstances 1): two processes run
# every loop twice (double SL moves, closes, sweeps and notices).
TRADE_LOOPS_ENABLED=
# The bot's env of those loops (same names, same Python int() parsing; a malformed ORPHAN_SWEEP_* int
# keeps auto-trade AND the loops from starting — D24)
# ORPHAN_SWEEP_ENABLED=1            only "0" (after strip) disables the sweeper
# ORPHAN_SWEEP_INTERVAL_S=300
# ORPHAN_SWEEP_MIN_ORDER_AGE_S=120
# ORPHAN_SWEEP_RECENT_OPEN_S=300
# RECONCILE_V2_MODE=enforce
# PANIC_CLOSE_STREAK=2              0 disables the anomaly detector's panic close
# POST_CLOSE_COOLDOWN_SEC=1800
# FUNDING_VELOCITY_EXIT_MODE=off    off / shadow / enforce
# FUNDING_VELOCITY_THRESHOLD=0.0001
# FUNDING_VELOCITY_MIN_WINDOW_S=600
# The bot's config.py values execute_auto_trade reads (same names, same parsing; an unparsable
# DAILY_MAX_LOSS_R keeps auto-trade from starting)
# DAILY_MAX_LOSS_R=0.0
# SMC_HOUR_FILTER_ENABLED=1
# SMC_HOUR_FILTER_MODE=enforce
# SMC_BAD_HOURS_UTC=4,18,19,20,22
# The bot's batch D risk safeguards of execute_auto_trade (read on every trade; a bad value is warned once)
# VOLUME_15M_MAX_RISK_PCT=0.25      [VOL15-RISK-CAP] VOLUME 15m risk cap, % of the balance (≤ 0 / not a number → off)
# AUTO_TRADE_MAX_SAME_DIRECTION=2   [SAME-DIR-CAP] open auto-trades per direction (≤ 0 → off; not a number → 2)
# AUTO_TRADE_FEE_AWARE_SIZING=1     [FEE-AWARE-SIZE] size after the entry + exit taker fee (0 / false / off / no → off)
# /api/app limits of the bot's Mini App (requests per user per 60 s)
MINIAPP_POST_PER_MIN=30
MINIAPP_CHART_PER_MIN=10

# ── Landing: public paper track (GET /api/public/{trend,stats,feed}) ───────
# System ("витринные") accounts whose delivered paper signals form the public track:
# "12,15" or "12:majors,15:alts" (users.id[:public alias]). Non-loginable, Pro, fixed
# strategy settings, the engine running for them. Empty → feed / stats answer the honest
# empty payload. The 60-minute delay, the fee model and the 30-signal threshold are constants.
PUBLIC_TRACK_USER_IDS=
# requests per IP per 60 s over the three paths (0 = off)
PUBLIC_API_RATE_PER_MIN=60
# HMAC key of the public signal ids (default JWT_SECRET)
PUBLIC_TRACK_ID_SECRET=

# ── Email (optional — for reset-password flows) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Seed helper passwords (dev only) ──────────────────────────────────────
SEED_ADMIN_PASSWORD=admin123456
SEED_TEST_PASSWORD=test12345
